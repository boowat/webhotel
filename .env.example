# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://hotel_user:hotel_pass@localhost:5432/hotel_bookings?schema=public"

# ─── Midtrans Sandbox ────────────────────────────────────
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PAYMENT_TIMEOUT_MINUTES=15

# ─── Cron Security ───────────────────────────────────────
CRON_SECRET="change-me-to-a-random-secret"

# ─── Email (existing) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Lumi Stays"
SMTP_FROM_EMAIL="bookings@lumistays.com"
