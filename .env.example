# ─── Database ────────────────────────────────────────────
# PostgreSQL connection. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://hotel_user:hotel_pass@localhost:5432/hotel_bookings?schema=public"

# ─── Midtrans Payment Gateway ───────────────────────────
# Get keys from https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxx"

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PAYMENT_TIMEOUT_MINUTES=15

# ─── Cron Security ───────────────────────────────────────
# Used to secure the /api/cron/expire-locks endpoint
CRON_SECRET="generate-a-random-secret-here"

# ─── Admin API ───────────────────────────────────────────
# Used to secure GET /api/bookings (list all bookings)
ADMIN_API_KEY="generate-a-random-admin-key-here"

# ─── Email (SMTP) ───────────────────────────────────────
# Production: use your SMTP provider (e.g. Mailgun, SendGrid)
# Development: use Mailtrap (https://mailtrap.io) or leave empty
#   to auto-create an Ethereal test account
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Hotel Des Indes"
SMTP_FROM_EMAIL="bookings@example.com"
